# Private Key (Get from MetaMask - Account Details -> Export Private Key)
# ⚠️ NEVER COMMIT YOUR ACTUAL .env FILE! ⚠️
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# RPC URLs (Optional - defaults are provided)
HOLESKY_RPC_URL=https://rpc.ankr.com/eth_holesky
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API Key (for contract verification - optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

ARC_TESTNET_RPC_URL=https://rpc.arc-testnet.io